{
  "name": "@kubetower/app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:perf": "vitest run --mode perf -t \"time ceiling\"",
    "test:watch": "vitest",
    "check:styles": "node scripts/check-styles.mjs",
    "gen:api": "openapi-typescript ../api/openapi.yaml -o ui/src/api/schema.ts",
    "check:api": "node scripts/check-api-types.mjs",
    "e2e": "playwright test",
    "measure": "vite -c measure/vite.config.ts",
    "test:layout": "playwright test -c measure/playwright.config.ts",
    "shots:extras": "node measure/shot-extras.mjs"
  },
  "dependencies": {
    "@kubetower/ui": "workspace:*",
    "@tanstack/react-query": "5.104.5",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
